local function GetCharacterParts()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hrp and hum and hum.Health > 0 then
            return char, hrp, hum
        end
    end
    return nil, nil, nil
end

local function FreezeBossModel(bossModel)
    if not bossModel then return end
    pcall(function()
        for _, part in pairs(bossModel:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
            end
        end
        local hum = bossModel:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.PlatformStand = true
        end
    end)
end

local function GetActiveBossModel(bossName)
    local bossesFolder = Workspace:FindFirstChild("BossesAreas")
    if not bossesFolder then return nil end
    local areaFolder = bossesFolder:FindFirstChild(bossName)
    if areaFolder then
        local model = areaFolder:FindFirstChild(bossName)
        if model and model:IsA("Model") then
            local hum = model:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Health > 0 then return model end
        end
    end
    return nil
end

