    local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()

    local AllowedGemNames = {
        "leftupperleg", "mesh", "meshpart", "meshes/fencebolt", "fencebolt",
        "meshes/dirt", "hacker border", "meshesassetsoceancylinder011",
        "oceancylinder", "meshesfloorssmenvtiles0", "robuxicon", "vines",
        "_gltfnode_1348_material_1"
    }

