        AutoFarm = false,
        SelectedBoss = "All Bosses (Auto Loop)",
        ServerHopAfterFarm = false,
        BringGems = false,
        BringMushrooms = false,
        AutoLift = false,
        StayZone = false
    }

    -- Player Character Helper
    local function GetCharacterParts()
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if hrp and hum and hum.Health > 0 then
                return char, hrp, hum
            end
        end
        return nil, nil, nil
    end

    local function MakeInvisible(state)
        local char = LocalPlayer.Character
        if not char then return end
        for _, child in pairs(char:GetDescendants()) do
            if (child:IsA("BasePart") and child.Name ~= "HumanoidRootPart") or child:IsA("Decal") then
                child.Transparency = state and 1 or 0
            elseif child:IsA("Accessory") then
                local handle = child:FindFirstChild("Handle")
                if handle then handle.Transparency = state and 1 or 0 end
            elseif child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
                child.Enabled = not state
            end
        end
    end

    local function FreezeBossModel(bossModel)
        if not bossModel then return end
        pcall(function()
            for _, part in pairs(bossModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.CanCollide = false
                end
            end
            local hum = bossModel:FindFirstChildWhichIsA("Humanoid")
            if hum then
                hum.WalkSpeed = 0
                hum.JumpPower = 0
                hum.PlatformStand = true
            end
        end)
    end

    local function GetActiveBossModel(bossName)
        local bossesFolder = Workspace:FindFirstChild("BossesAreas")
        if not bossesFolder then return nil end
        local areaFolder = bossesFolder:FindFirstChild(bossName)
        if areaFolder then
            local model = areaFolder:FindFirstChild(bossName)
            if model and model:IsA("Model") then
                local hum = model:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health > 0 then return model end
            end
        end
        return nil
    end

    local function GetPlayerGold()
        local goldVal = "N/A"
        pcall(function()
            local statsFolder = LocalPlayer:FindFirstChild("leaderstats") or LocalPlayer:FindFirstChild("Stats") or LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("PlayerStats")
            if statsFolder then
                local possibleNames = {"GoldBar", "GoldBars", "Gold_Bar", "Bar", "Bars", "Ingot", "GoldIngot", "Gold"}
                for _, name in ipairs(possibleNames) do
                    local item = statsFolder:FindFirstChild(name)
                    if item then goldVal = tostring(item.Value); return end
                end
            end

            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                for _, desc in pairs(playerGui:GetDescendants()) do
                    if (desc:IsA("TextLabel") or desc:IsA("TextBox")) and string.match(desc.Text, "^%d+$") then
                        if tonumber(desc.Text) and tonumber(desc.Text) > 1000 then
                            if desc.Parent and (desc.Parent.Name:lower():find("bar") or desc.Parent.Name:lower():find("gold")) then
                                goldVal = desc.Text; return
                            end
                        end
                    end
                end
            end
        end)
        return goldVal
    end

