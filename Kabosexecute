local function SendDiscordWebhook(bossKilledName)
    if not StatsTracker.SendWebhook or StatsTracker.WebhookUrl == "" then return end
    
    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then return end

    local bossBreakdown = ""
    for bName, count in pairs(StatsTracker.BossKills) do
        if count > 0 then
            bossBreakdown = bossBreakdown .. "• **" .. bName .. "**: " .. tostring(count) .. "\n"
        end
    end
    if bossBreakdown == "" then bossBreakdown = "لا يوجد قتل حتى الآن" end

    local payload = HttpService:JSONEncode({
        ["username"] = "Kabos Hub Tracker",
        ["avatar_url"] = "https://i.imgur.com/AfFp7pu.png",
        ["embeds"] = {{
            ["title"] = "⚔️ Boss Farm Stats Update!",
            ["color"] = 65280,
            ["fields"] = {
                { ["name"] = "👤 Player", ["value"] = LocalPlayer.Name, ["inline"] = true },
                { ["name"] = "🪙 Gold Bars", ["value"] = GetPlayerGold(), ["inline"] = true },
                { ["name"] = "💎 Gems", ["value"] = GetPlayerGems(), ["inline"] = true },
                { ["name"] = "🎯 Last Killed Boss", ["value"] = bossKilledName or "N/A", ["inline"] = false },
                { ["name"] = "💀 Total Kills", ["value"] = tostring(StatsTracker.TotalKills), ["inline"] = true },
                { ["name"] = "📊 Bosses Breakdown", ["value"] = bossBreakdown, ["inline"] = false }
            },
            ["footer"] = { ["text"] = "Kabos Hub - Auto Status Log" },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    })

    pcall(function()
        requestFunc({
            Url = StatsTracker.WebhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
end

local VisitedServersFile = "kabos_visited.json"
local QueueOnTeleport = (queue_on_teleport or syn and syn.queue_on_teleport or fluxus and fluxus.queue_on_teleport)

local function SmartServerHop()
    task.wait(math.random(3, 5))

    if QueueOnTeleport then
        QueueOnTeleport([[
            repeat task.wait() until game:IsLoaded()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
        ]])
    end

    local visited = {}
    if isfile and isfile(VisitedServersFile) then
        pcall(function() visited = HttpService:JSONDecode(readfile(VisitedServersFile)) or {} end)
    end
    table.insert(visited, game.JobId)
    if writefile then writefile(VisitedServersFile, HttpService:JSONEncode(visited)) end

    local placeId = game.PlaceId
    local serversUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function() return HttpService:JSONDecode(game:HttpGet(serversUrl)) end)

    if success and response and response.data then
        for _, server in ipairs(response.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                local alreadyVisited = false
                for _, vId in ipairs(visited) do
                    if vId == server.id then alreadyVisited = true; break end
                end
                if not alreadyVisited then
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                    task.wait(4)
                    return
                end
            end
        end
    end
    if writefile then writefile(VisitedServersFile, HttpService:JSONEncode({})) end
    TeleportService:Teleport(placeId, LocalPlayer)
end

