-- Character Helpers
local function GetCharacterParts()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hrp and hum and hum.Health > 0 then
            return char, hrp, hum
        end
    end
    return nil, nil, nil
end

local function MakeInvisible(state)
    local char = LocalPlayer.Character
    if not char then return end
    for _, child in pairs(char:GetDescendants()) do
        if (child:IsA("BasePart") and child.Name ~= "HumanoidRootPart") or child:IsA("Decal") then
            child.Transparency = state and 1 or 0
        elseif child:IsA("Accessory") then
            local handle = child:FindFirstChild("Handle")
            if handle then handle.Transparency = state and 1 or 0 end
        end
    end
end

local function FreezeBossModel(bossModel)
    if not bossModel then return end
    pcall(function()
        for _, part in pairs(bossModel:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
            end
        end
        local hum = bossModel:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.PlatformStand = true
        end
    end)
end

local function GetActiveBossModel(bossName)
    local bossesFolder = Workspace:FindFirstChild("BossesAreas")
    if not bossesFolder then return nil end
    local areaFolder = bossesFolder:FindFirstChild(bossName)
    if areaFolder then
        local model = areaFolder:FindFirstChild(bossName)
        if model and model:IsA("Model") then
            local hum = model:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Health > 0 then return model end
        end
    end
    return nil
end

-- 🌐 Smart Server Hop
local VisitedServersFile = "Kabos_Visited_Servers.json"
local QueueOnTeleport = (queue_on_teleport or syn and syn.queue_on_teleport or fluxus and fluxus.queue_on_teleport)

local function SmartServerHop()
    if QueueOnTeleport then
        QueueOnTeleport([[
            repeat task.wait() until game:IsLoaded()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/tarkh3673-coder/Kabos-hub/refs/heads/main/Kabosexecute"))()
        ]])
    end

    local visited = {}
    if isfile and isfile(VisitedServersFile) then
        pcall(function() visited = HttpService:JSONDecode(readfile(VisitedServersFile)) or {} end)
    end
    
    local currentJobId = game.JobId
    local alreadyInList = false
    for _, id in ipairs(visited) do
        if id == currentJobId then alreadyInList = true; break end
    end
    if not alreadyInList then table.insert(visited, currentJobId) end
    if writefile then writefile(VisitedServersFile, HttpService:JSONEncode(visited)) end

    local placeId = game.PlaceId
    local serversUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function() return HttpService:JSONDecode(game:HttpGet(serversUrl)) end)

    if success and response and response.data then
        for _, server in ipairs(response.data) do
            if server.playing < server.maxPlayers and server.id ~= currentJobId then
                local isVisited = false
                for _, vId in ipairs(visited) do
                    if vId == server.id then isVisited = true; break end
                end
                if not isVisited then
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                    task.wait(4)
                    return
                end
            end
        end
    end
    if writefile then writefile(VisitedServersFile, HttpService:JSONEncode({})) end
    TeleportService:Teleport(placeId, LocalPlayer)
end

