-- Loop ⚡ Auto Stay Zone
task.spawn(function()
    while true do
        if IsUnlocked and Toggles.StayZone then
            pcall(function()
                local _, hrp, hum = GetCharacterParts()
                local bossesFolder = Workspace:FindFirstChild("BossesAreas")
                if hrp and hum and hum.Health > 0 and bossesFolder then
                    for _, bossName in ipairs(TargetBossNames) do
                        if bossName ~= "All Bosses (Auto Loop)" then
                            local areaFolder = bossesFolder:FindFirstChild(bossName)
                            local zone = areaFolder and (areaFolder:FindFirstChild("Zone") or areaFolder:FindFirstChildWhichIsA("BasePart"))
                            if zone then
                                hrp.CFrame = zone.CFrame + Vector3.new(0, 3, 0)
                                break
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- Loop ⚔️ Auto Farm Bosses
task.spawn(function()
    while true do
        task.wait(0.2)
        if IsUnlocked and Toggles.AutoFarm then
            local char, hrp, humanoid = GetCharacterParts()

            if char and hrp and humanoid and humanoid.Health > 0 then
                local attackEvent = ReplicatedStorage:FindFirstChild("4c85c5705ad44e27883ec776e056211e")

                local bossListToFarm = {}
                if Toggles.SelectedBoss == "All Bosses (Auto Loop)" then
                    for i = 2, #TargetBossNames do
                        table.insert(bossListToFarm, TargetBossNames[i])
                    end
                else
                    table.insert(bossListToFarm, Toggles.SelectedBoss)
                end

                for _, bossName in ipairs(bossListToFarm) do
                    if not (IsUnlocked and Toggles.AutoFarm) then break end

                    local bossModel = GetActiveBossModel(bossName)
                    if bossModel then
                        local bossHum = bossModel:FindFirstChildWhichIsA("Humanoid")
                        local bossPart = bossModel:FindFirstChild("HumanoidRootPart") or bossModel:FindFirstChildWhichIsA("BasePart")

                        if bossPart and bossHum and bossHum.Health > 0 then
                            local bossesFolder = Workspace:FindFirstChild("BossesAreas")
                            local areaFolder = bossesFolder and bossesFolder:FindFirstChild(bossName)
                            local zonePart = areaFolder and (areaFolder:FindFirstChild("Zone") or areaFolder:FindFirstChildWhichIsA("BasePart"))

                            FreezeBossModel(bossModel)

                            if zonePart then
                                hrp.CFrame = zonePart.CFrame + Vector3.new(0, 2, 0)
                            else
                                hrp.CFrame = CFrame.new(bossPart.Position + Vector3.new(0, 5, 8), bossPart.Position)
                            end

                            task.wait(0.1)

                            while IsUnlocked and Toggles.AutoFarm and bossModel and bossModel.Parent and bossHum and bossHum.Health > 0 do
                                local currentChar, currentHrp, currentHum = GetCharacterParts()
                                if not currentChar or not currentHum or currentHum.Health <= 0 then break end

                                FreezeBossModel(bossModel)
                                currentHum:MoveTo(bossPart.Position + (bossPart.CFrame.LookVector * -10))

                                if (currentHrp.Position - bossPart.Position).Magnitude > 300 then
                                    currentHrp.CFrame = CFrame.new(bossPart.Position + Vector3.new(0, 5, 8), bossPart.Position)
                                end

                                if attackEvent then
                                    for i = 1, 10 do attackEvent:FireServer("PUNCH", bossModel) end
                                end
                                task.wait(0.02)
                            end
                        end
                    end
                end
            else
                task.wait(0.5)
            end
        end
    end
end)
