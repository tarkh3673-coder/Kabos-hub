local function StartKabosHub()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")

    local LocalPlayer = Players.LocalPlayer

    -- Stats File Path
    local StatsFile = "kabos_stats.json"

    -- Stats Tracker for Discord Webhook
    local StatsTracker = {
        TotalKills = 0,
        BossKills = {},
        WebhookUrl = "",
        SendWebhook = false
    }

    -- Target Boss Names
    local TargetBossNames = {
        "All Bosses (Auto Loop)",
        "WaterBoss", "BattleBot", "MechGolem", "KnightBoss", 
        "GlitchBoss", "Boss2", "Boss1", "TheGreatWitch", "Anubis"
    }

    for i = 2, #TargetBossNames do
        StatsTracker.BossKills[TargetBossNames[i]] = 0
    end

    -- Load Stats from File
    local function LoadSavedStats()
        if isfile and isfile(StatsFile) then
            pcall(function()
                local data = HttpService:JSONDecode(readfile(StatsFile))
                if data then
                    StatsTracker.TotalKills = data.TotalKills or 0
                    if data.BossKills then
                        for boss, count in pairs(data.BossKills) do
                            StatsTracker.BossKills[boss] = count
                        end
                    end
                end
            end)
        end
    end

    -- Save Stats to File
    local function SaveStats()
        if writefile then
            pcall(function()
                local data = {
                    TotalKills = StatsTracker.TotalKills,
                    BossKills = StatsTracker.BossKills
                }
                writefile(StatsFile, HttpService:JSONEncode(data))
            end)
        end
    end

    LoadSavedStats()

    -- Disable Gold Popups
    local function DisableGoldPopups(targetFolder)
        if not targetFolder then return end
        for _, child in pairs(targetFolder:GetDescendants()) do
            if child.Name == "GoldStatsGui" then
                pcall(function() child:Destroy() end)
            end
        end
        targetFolder.DescendantAdded:Connect(function(child)
            if child.Name == "GoldStatsGui" then
                task.wait()
                pcall(function() child:Destroy() end)
            end
        end)
    end
    DisableGoldPopups(LocalPlayer:WaitForChild("PlayerGui"))
    DisableGoldPopups(Workspace)

    -- Load Fluent UI Library & SaveManager
