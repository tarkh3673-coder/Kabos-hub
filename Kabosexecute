-- 🔍 Farm Gem Loop
local function IsExactAllowedGem(item)
    if not item then return false end
    local itemNameLower = string.lower(item.Name)
    local isMatched = false
    for _, allowedName in ipairs(AllowedGemNames) do
        if itemNameLower:find(allowedName, 1, true) then isMatched = true; break end
    end
    if not isMatched then return false end

    local hasTouch = item:FindFirstChildWhichIsA("TouchTransmitter", true) or item:FindFirstChild("TouchInterest", true)
    local hasPrompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    return (hasTouch ~= nil or hasPrompt ~= nil)
end

task.spawn(function()
    while true do
        if Toggles.FarmGem then
            pcall(function()
                local _, hrp, hum = GetCharacterParts()
                if hrp and hum and hum.Health > 0 then
                    for _, item in pairs(Workspace:GetDescendants()) do
                        if IsExactAllowedGem(item) then
                            local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                            if targetPart and targetPart.Size.Magnitude < 10 then
                                targetPart.CFrame = hrp.CFrame
                                local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if firetouchinterest then
                                    firetouchinterest(hrp, targetPart, 0)
                                    task.wait(0.01)
                                    firetouchinterest(hrp, targetPart, 1)
                                elseif prompt and fireproximityprompt then
                                    fireproximityprompt(prompt)
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)

