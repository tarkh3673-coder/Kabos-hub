local function LoadSavedStats()
    if isfile and isfile(StatsFile) then
        pcall(function()
            local data = HttpService:JSONDecode(readfile(StatsFile))
            if data then
                StatsTracker.TotalKills = data.TotalKills or 0
                if data.BossKills then
                    for boss, count in pairs(data.BossKills) do
                        StatsTracker.BossKills[boss] = count
                    end
                end
            end
        end)
    end
end

local function SaveStats()
    if writefile then
        pcall(function()
            local data = {
                TotalKills = StatsTracker.TotalKills,
                BossKills = StatsTracker.BossKills
            }
            writefile(StatsFile, HttpService:JSONEncode(data))
        end)
    end
end

